{"axis": "loops", "level": 0, "knob": 3, "name": "loops_N3", "dsl": "\\system{cchain_3}\n\\defvar{x1}{Position}{m}\n\\defvar{y1}{Position}{m}\n\\defvar{x2}{Position}{m}\n\\defvar{y2}{Position}{m}\n\\parameter{m}{1.0}{kg}\n\\parameter{g}{9.81}{m/s^2}\n\\lagrangian{(0.5*m*(\\dot{x1}^2 + \\dot{y1}^2) + 0.5*m*(\\dot{x2}^2 + \\dot{y2}^2)) - (m*g*y1 + m*g*y2)}\n\\constraint{(x1 - 0.0)^2 + (y1 - 0.0)^2 - 2.9999999999999996}\n\\constraint{(x2 - x1)^2 + (y2 - y1)^2 - 2.9999999999999996}\n\\constraint{(0.0 - x2)^2 + (0.0 - y2)^2 - 2.9999999999999996}\n\\initial{x1=-1.5, y1=0.866, x1_dot=-0.3464, y1_dot=-0.6, x2=-1.5, y2=-0.866, x2_dot=0.3464, y2_dot=-0.6}", "tools": ["constrained"], "formulation": "constrained", "conservative": true, "expected_moving": true, "t_span": [0.0, 3.0], "num_points": 600, "tool": "constrained"}